<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20250120-play-padel-user-00" author="lokovic">
        <createTable tableName="play_padel_user">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>

            <column name="play_padel_username" type="VARCHAR(255)"/>
            <column name="play_padel_password" type="VARCHAR(255)"/>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="user_type" type="VARCHAR(255)"/>
            <column name="contact_number" type="VARCHAR(255)"/>
            <column name="address" type="VARCHAR(255)"/>
            <column name="padel_hall_name" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="20250120-padel-court-00" author="lokovic">
        <createTable tableName="padel_court">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="location" type="VARCHAR(255)"/>
            <column name="court_type" type="VARCHAR(255)"/>
            <column name="opening_time" type="TIMESTAMP"/>
            <column name="closing_time" type="TIMESTAMP"/>

            <column name="padel_court_id" type="BIGINT">
                <constraints foreignKeyName="fk_padel_court_id" references="play_padel_user(id)"/>
            </column>
        </createTable>

        <createTable tableName="padel_court_booking">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="start_booking_time" type="TIMESTAMP"/>
            <column name="end_booking_time" type="TIMESTAMP"/>
            <column name="booking_user_id" type="BIGINT">
                <constraints foreignKeyName="fk_booking_user_id" references="play_padel_user(id)"/>
            </column>
            <column name="padel_court_booking_id" type="BIGINT">
                <constraints foreignKeyName="fk_padel_court_booking_id" references="padel_court(id)"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>